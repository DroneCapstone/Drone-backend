  "cards": [
    {
      "dot": "emerald",
      "title": "① Distance — Haversine Only",
      "items": [
        "No external map API — purely mathematical formula",
        "Uses hub.latitude / hub.longitude from DB",
        "R = 6371 km, returns straight-line great-circle km"
      ]
    },
    {
      "dot": "cyan",
      "title": "② AI Energy Prediction",
      "items": [
        "Physics baseline: dist_km × (15 Wh + 2.2 Wh/kg payload)",
        "SHAP corrections: speed drag, altitude climb, wind headwind",
        "ML blend: dji_model.pkl mixed with physics when model loaded",
        "Weather: deterministic CSV row — no Open-Meteo call here"
      ]
    },
    {
      "dot": "amber",
      "title": "③ Delivery Fee (Hardcoded Tiers)",
      "items": [
        "Tiered by payload: ≤1 kg / ≤3 kg / ≤5 kg / >5 kg",
        "core_fee = base + dist×rate_km + payload×rate_kg",
        "Surcharges: Fragile +15%, Express +25%, Insurance +10%",
        "Pricing is NOT stored in DB — hardcoded in calculate_delivery_cost()"
      ]
    },
    {
      "dot": "violet",
      "title": "④ Hub Resource Readiness",
      "items": [
        "T_queue: waiting orders × 15 min each",
        "T_charge: time to reach 80% battery at 1% per min",
        "T_dispatch: 0 (local) / +20 min (cross-hub) / +30 min (fleet busy)",
        "total_extra_wait = max(T_queue, T_charge) + T_dispatch → added to ETA"
      ]
    }
  ]
