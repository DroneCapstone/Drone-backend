, "to": "router", "y": 372, "label": "HMAC-SHA256(canonical, CHECKSUM_KEY)", "variant": "security", "note": "Compare hex digests case-insensitively"}, {"id": "sig-invalid", "from": "router", "to": "payos", "y": 430, "label": "If mismatch → 400 Invalid signature", "variant": "dashed"}, {"id": "find-order", "from": "router", "to": "db", "y": 460, "label": "SELECT Order WHERE payment_order_code = :orderCode", "variant": "emphasis", "note": "Extract orderCode, code, reference from data"}, {"id": "order-found", "from": "db", "to": "router", "y": 528, "label": "order (or None → 200 ignored)", "variant": "return"}, {"id": "update-paid", "from": "router", "to": "db", "y": 570, "label": "UPDATE: payment_status=PAID, paid_at, txn_id", "variant": "emphasis", "note": "If code=='00' and status==PENDING → AWAITING_DROP_OFF"}, {"id": "update-failed", "from": "router", "to": "db", "y": 638, "label": "Else: payment_status=FAILED", "variant": "dashed"}, {"id": "send-notif", "from": "router", "to": "notif", "y": 670, "label": "notify customer payment confirmed", "variant": "dashed", "note": "ref_id = ORDER_PAID_{id} · anti-duplicate"}, {"id": "commit", "from": "router", "to": "db", "y": 730, "label": "COMMIT", "variant": "emphasis"}, {"id": "webhook-ok", "from": "router", "to": "payos", "y": 758, "label": "200 { message: OK }", "variant": "return"}], "activations": [{"participant": "router", "from": 155, "to": 770, "type": "backend"}, {"participant": "hmac", "from": 293, "to": 382, "type": "security"}, {"participant": "db", "from": 455, "to": 540, "type": "database"}, {"participant": "db", "from": 565, "to": 656, "type": "database"}, {"participant": "notif", "from": 665, "to": 710, "type": "messagebus"}, {"participant": "db", "from": 725, "to": 742, "type": "database"}], "cards": [{"dot": "emerald", "title": "Happy Path (code == '00')", "items": ["PayOS sends webhook with HMAC-SHA256 signature", "Router verifies signature against CHECKSUM_KEY", "Finds order by payment_order_code (unique)", "Sets payment_status=PAID, order.status=AWAITING_DROP_OFF", "Sends notification to customer (anti-duplicate via ref_id)"]}, {"dot": "rose", "title": "Failure & Guard Paths", "items": ["Empty data → 200 OK immediately (webhook registration verify)", "Invalid signature → 400 (HMAC mismatch, case-insensitive compare)", "Order not found by payment_order_code → 200 ignored", "code != '00' → payment_status=FAILED, no notification sent"]}, {"dot": "cyan", "title": "HMAC-SHA256 Verification", "items": ["Sort data keys alphabetically", "Build canonical: k1=v1&k2=v2… (null/undefined → empty string)", "Compute hmac.new(CHECKSUM_KEY, canonical, sha256)", "Compare hex digests case-insensitively (hmac.compare_digest)"]}, {"dot": "violet", "title": "Status Transitions", "items": ["Payment: PENDING → PAID (code '00') or FAILED (other)", "Order: PENDING → AWAITING_DROP_OFF (customer must drop off package)", "Notification uses reference_id ORDER_PAID_{id} to prevent duplicates", "Webhook always returns 200 to PayOS (even on order not found)"]}]}