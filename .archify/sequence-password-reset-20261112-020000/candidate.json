  "cards": [
    {
      "dot": "emerald",
      "title": "Phase 1 — Request Reset Link",
      "items": [
        "Client POSTs email; service looks up account in DB",
        "Token generated via secrets.token_urlsafe(32), saved with 15-min expiry",
        "Email sent with link: {FRONTEND_URL}/reset-password?token=…",
        "Response is always the same — prevents email enumeration"
      ]
    },
    {
      "dot": "cyan",
      "title": "Phase 2 — Submit New Password",
      "items": [
        "Client POSTs token + new_password from the email link",
        "DB checks token match AND reset_token_expires_at > now()",
        "bcrypt hashes new password; token cleared (set to NULL)",
        "Returns 200 on success; 400 if token invalid or expired"
      ]
    },
    {
      "dot": "rose",
      "title": "Security Notes",
      "items": [
        "Token stored in DB as plain random string — not JWT",
        "15-minute expiry enforced at DB query time",
        "Single-use: token nulled after successful reset",
        "Silent failure on unknown email — no information leakage"
      ]
    }
  ]
