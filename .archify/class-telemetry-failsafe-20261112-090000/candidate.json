hared/drone_simulator.py", "line": 697}], "methods": [{"name": "simulate_mission_flight", "parameters": "mission_id: str", "returns": "None", "visibility": "public", "static": true}, {"name": "_interpolate", "parameters": "from_hub, to_hub, steps=20", "returns": "list[waypoints]", "visibility": "public", "static": true}, {"name": "_trigger_incident", "parameters": "mission_id, lat, lng, hub", "returns": "None", "visibility": "public", "static": true}, {"name": "_trigger_disconnect_crash", "parameters": "mission_id, lat, lng, hub", "returns": "None", "visibility": "public", "static": true}, {"name": "_fly_incident_return", "parameters": "mission_id, waypoints, hub", "returns": "None", "visibility": "public", "static": true}]}, {"id": "signal_watcher", "label": "SignalLossWatcher", "kind": "class", "sublabel": "shared/workers.py · 3s cron", "row": 1, "col": 1, "sources": [{"path": "app/shared/workers.py", "line": 103}], "methods": [{"name": "run_telemetry_signal_loss_watcher", "parameters": "db: AsyncSession", "returns": "None", "visibility": "public", "static": true}]}, {"id": "telemetry_router", "label": "MissionRouter", "kind": "class", "sublabel": "operator/router.py · telemetry + failsafe", "row": 1, "col": 2, "sources": [{"path": "app/modules/missions/operator/router.py", "line": 646}], "methods": [{"name": "collect_telemetry", "parameters": "mission_id, telemetry_data[]", "returns": "TelemetryIngestResponse", "visibility": "public"}, {"name": "evaluate_mission_failsafe", "parameters": "mission_id, body", "returns": "FailsafeEvaluateResponse", "visibility": "public"}, {"name": "emergency_land", "parameters": "mission_id, body", "returns": "EmergencyLandResponse", "visibility": "public"}, {"name": "execute_mission_failsafe", "parameters": "mission_id, body", "returns": "FailsafeExecuteResponse", "visibility": "public"}]}], "relationships": [{"id": "r1", "from": "simulator", "to": "telemetry_log", "kind": "dependency", "label": "inserts per waypoint"}, {"id": "r2"