  "cards": [
    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "Client POSTs email + password to /api/v1/auth/login",
        "Pydantic validates format; service queries the accounts table",
        "bcrypt verifies the password hash; login logged to activity_logs",
        "Returns access token (60 min) + refresh token (7 days)"
      ]
    },
    {
      "dot": "rose",
      "title": "Error Cases",
      "items": [
        "401 — user not found, hashed_password missing, or bcrypt mismatch",
        "403 — user found but is_active = False (soft-deleted / suspended)",
        "Both share the same 401 message to prevent email enumeration"
      ]
    },
    {
      "dot": "cyan",
      "title": "JWT Structure",
      "items": [
        "access_token: {sub: user_id, role, type: access} · HS256",
        "refresh_token: {sub: user_id, type: refresh} · HS256",
        "type field distinguishes tokens on protected endpoints",
        "Stateless — no token stored in DB; logout = client deletes token"
      ]
    }
  ]
